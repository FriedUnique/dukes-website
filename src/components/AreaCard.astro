---
interface Props { title: string; text: string; img: string; href: string; tag?: string; class?: string }
const { title, text, img, href, tag, class: cls = '' } = Astro.props;
---
<a href={href} class:list={['group relative block overflow-hidden rounded-2xl bg-wood min-h-72 shadow-lg', cls]}>
  <img src={img} alt={title} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
  <div class="absolute inset-0 bg-gradient-to-t from-bark/75 via-bark/10 to-transparent"></div>
  <div class="relative flex h-full min-h-72 flex-col justify-end p-6 text-cream">
    {tag && <span class="mb-2 w-fit rounded-full bg-gold px-3 py-0.5 text-xs font-semibold text-ink">{tag}</span>}
    <h3 class="text-2xl">{title}</h3>
    <p class="mt-1 text-sm text-cream/85">{text}</p>
  </div>
</a>

