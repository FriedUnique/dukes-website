---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { isoDay } from '../lib/content';
interface Props { event: CollectionEntry<'events'>; compact?: boolean }
const { event: e, compact = false } = Astro.props;
const { Content } = await render(e);
const search = [e.data.title, e.data.area, e.body ?? ''].join(' ').toLowerCase();
---
<li data-event data-date={isoDay(e.data.date)} data-search={search} class="flex gap-5 overflow-hidden rounded-2xl bg-sand p-5">
  <div class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-xl bg-ink text-cream">
    <span class="text-2xl font-bold leading-none">{e.data.date.getUTCDate()}</span>
    <span class="text-xs uppercase">{e.data.date.toLocaleDateString('de-CH', { month: 'short', timeZone: 'UTC' })}</span>
  </div>
  <div class="min-w-0 flex-1">
    <h3 class="text-xl sm:text-2xl">{e.data.title}</h3>
    <p class="text-sm font-semibold text-rust">{e.data.area}{e.data.time && ` · ${e.data.time} Uhr`}{e.data.price && ` · ${e.data.price}`}</p>
    {!compact && <div class="mt-2 text-bark/80"><Content /></div>}
  </div>
  {e.data.image && !compact && (
    <a href={e.data.image} target="_blank" class="hidden shrink-0 sm:block">
      <img src={e.data.image} alt={`Plakat ${e.data.title}`} loading="lazy" class="h-32 w-auto rounded-lg shadow" />
    </a>
  )}
</li>
