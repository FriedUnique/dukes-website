---
import { nav } from '../data/nav';
---
<footer class="bg-ink text-cream/80">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-3xl font-bold text-gold">dukes</p>
      <p class="mt-1 text-sm">Restaurant, Partylokal sihl3</p>
      <p class="mt-4 text-sm">Steaks, Events &amp; Nightlife im Herzen von Zürich.</p>
    </div>
    <div>
      <h3 class="text-gold text-lg">Öffnungszeiten</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li class="flex justify-between gap-4"><span>Restaurant</span><span>MO–FR 08:00–14:00</span></li>
        <li class="flex justify-between gap-4"><span>Abendservice</span><span>MI–SA ab 18:00</span></li>
        <li class="flex justify-between gap-4"><span>Club</span><span>MI–SO ab 20:00</span></li>
        <li class="flex justify-between gap-4"><span>Fonduestübli</span><span>FR/SA ab 18:00</span></li>
      </ul>
    </div>
    <div>
      <h3 class="text-gold text-lg">Reservation</h3>
      <p class="mt-3 text-sm"><a class="hover:text-gold text-lg font-semibold text-cream" href="tel:+41432444040">043 244 40 40</a></p>
      <p class="text-sm"><a class="hover:text-gold underline underline-offset-4" href="mailto:reservation@dukes.ch">reservation@dukes.ch</a></p>
      <p class="mt-3 text-xs text-cream/60">Anfragen werden bis 10:00 des Tages bearbeitet und nur per E-Mail bestätigt.</p>
    </div>
  </div>
  <div class="border-t border-white/10 px-5 py-5 text-center text-xs text-cream/50">
    <nav class="mb-2 flex flex-wrap justify-center gap-x-5 gap-y-1">
      {nav.map((n) => <a href={n.href} class="hover:text-gold">{n.label}</a>)}
    </nav>
    © {new Date().getFullYear()} dukes Restaurant, Partylokal sihl3
  </div>
</footer>

