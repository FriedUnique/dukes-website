---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Layout title="Kontakt – dukes">
  <PageHeader eyebrow="Wir freuen uns auf Sie" title="Kontakt" intro="Reservation und Anfragen." />
  <section class="mx-auto max-w-4xl space-y-12 px-5 py-16">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl bg-sand p-6">
        <h2 class="text-2xl">Reservation</h2>
        <p class="mt-3"><a class="text-lg font-semibold" href="tel:+41432444040">043 244 40 40</a></p>
        <p><a class="underline" href="mailto:reservation@dukes.ch">reservation@dukes.ch</a></p>
        <p class="mt-3 text-sm text-bark/70">Anfragen werden bis 10:00 des Tages bearbeitet, Bestätigung nur per E-Mail.</p>
      </div>
      <div class="rounded-2xl bg-sand p-6">
        <h2 class="text-2xl">Öffnungszeiten</h2>
        <ul class="mt-3 space-y-1 text-sm">
          <li>Restaurant: MO–FR 08:00–14:00</li>
          <li>Abend: MI–SA ab 18:00</li>
          <li>Club: MI–SO ab 20:00</li>
          <li>Fonduestübli: FR/SA ab 18:00</li>
        </ul>
      </div>
    </div>
    <p class="text-bark/70">Adresse &amp; Anfahrt: bitte ergänzen.</p>
  </section>
</Layout>
