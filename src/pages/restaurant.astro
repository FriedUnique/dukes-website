---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Layout title="Restaurant – dukes">
  <PageHeader eyebrow="Essen & Trinken" title="Restaurant" intro="Rustikale Küche in warmer Atmosphäre." />
  <section class="mx-auto max-w-4xl space-y-12 px-5 py-16">
    <div class="grid gap-8 md:grid-cols-2 md:items-center">
      <img src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=900&q=70" alt="Steak vom Grill" loading="lazy" class="rounded-2xl shadow-lg" />
      <div><h2 class="text-3xl">Steaks &amp; mehr</h2><p class="mt-3 text-bark/80">Unter der Woche Mittagsmenü, am Abend Steaks vom Grill und Klassiker aus der Saloon-Küche. Platzhaltertext – bitte ergänzen.</p></div>
    </div>
    <div class="grid gap-5 sm:grid-cols-3">
      <div class="rounded-2xl bg-sand p-6"><h3 class="text-xl">Saloon</h3><p class="mt-2 text-sm text-bark/80">Drinks und Western-Flair an der Bar.</p></div>
      <div class="rounded-2xl bg-sand p-6"><h3 class="text-xl">Terrasse</h3><p class="mt-2 text-sm text-bark/80">Aussenbereich für Sommerabende.</p></div>
      <div class="rounded-2xl bg-sand p-6"><h3 class="text-xl">Fonduestübli</h3><p class="mt-2 text-sm text-bark/80">Fr/Sa ab 18:00 – gemütlich geniessen.</p></div>
    </div>
    <p class="text-center"><a href="/wochenmenu" class="rounded-full bg-ink px-7 py-3 font-semibold text-cream hover:bg-rust">Zum Wochenmenü</a></p>
  </section>
</Layout>
