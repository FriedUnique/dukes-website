---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const timeline = [
  { year: '1997', text: 'Eröffnung als Club in Sihlbrugg – der Grundstein für das heutige Partylokal sihl3.' },
  { year: '2009', text: 'Im Sommer kommt das Restaurant im Erdgeschoss dazu: erst essen, dann feiern.' },
  { year: '2013', text: 'Der Eventsaal öffnet – Raum für Feste, Firmenanlässe und Live-Bands.' },
  { year: 'Heute', text: 'Restaurant, Saloon, Wintergarten, Eventsaal und Club unter einem Dach.' },
];
const rooms = [
  { name: 'Eventsaal', size: '190 m²' },
  { name: 'Restaurant', size: '150 m²' },
  { name: 'Club', size: '150 m²' },
  { name: 'Saloon', size: '70 m²' },
  { name: 'Wintergarten', size: '60 m²' },
];
---
<Layout title="Über uns – dukes" description="Seit 1997 in Sihlbrugg: dukes Restaurant, Saloon, Eventsaal und Partylokal sihl3.">
  <PageHeader eyebrow="Seit 1997 in Sihlbrugg" title="Über uns" intro="Essen, trinken, tanzen – alles unter einem Dach." />

  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-2 md:items-center">
    <div>
      <h2 class="text-3xl sm:text-4xl">Vom Club zum Treffpunkt</h2>
      <p class="mt-4 text-bark/80">Was 1997 als Club in Sihlbrugg begann, ist heute ein Ort für den ganzen Tag: Mittagsmenü unter der Woche, Abendessen im Restaurant oder Saloon und danach Party im sihl3. Das Konzept ist einfach – bei uns können Sie gemütlich essen und danach gleich bleiben und feiern.</p>
      <p class="mt-4 text-bark/80">Geführt wird das dukes seit der Eröffnung von Inhaber <strong>Markus Huber</strong>. Am Wochenende spielen regelmässig Bands aus der Region im Eventsaal.</p>
    </div>
    <img src="/images/start.jpg" alt="Das dukes in Sihlbrugg bei Nacht" loading="lazy" class="rounded-2xl shadow-lg" />
  </section>

  <section class="bg-sand">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-3xl">Unsere Geschichte</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-4">
        {timeline.map((t) => (
          <li class="border-t-4 border-gold pt-4">
            <p class="font-display text-3xl font-bold text-rust">{t.year}</p>
            <p class="mt-2 text-sm text-bark/80">{t.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-2 md:items-center">
    <img src="/images/saloon.jpg" alt="Saloon" loading="lazy" class="rounded-2xl shadow-lg md:order-last" />
    <div>
      <h2 class="text-3xl">Räume &amp; Flächen</h2>
      <ul class="mt-6 divide-y divide-bark/15">
        {rooms.map((r) => <li class="flex justify-between py-3"><span class="font-semibold">{r.name}</span><span class="text-bark/70">{r.size}</span></li>)}
      </ul>
      <p class="mt-4 text-sm text-bark/70">Parkplätze direkt vor dem Haus.</p>
      <a href="/#lokal-mieten" class="mt-6 inline-block rounded-full bg-ink px-7 py-3 font-semibold text-cream hover:bg-rust">Lokal mieten</a>
    </div>
  </section>
</Layout>
