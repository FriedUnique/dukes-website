  <section class="mx-auto max-w-4xl space-y-12 px-5 py-16">
    <div class="grid gap-8 md:grid-cols-2 md:items-center">
      <div><h2 class="text-3xl">Restaurant, Partylokal sihl3</h2><p class="mt-3 text-bark/80">dukes vereint Restaurant, Saloon, Eventsaal und Club unter einem Dach. Platzhaltertext – bitte die Geschichte und das Team ergänzen.</p></div>
      <img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&w=900&q=70" alt="dukes" loading="lazy" class="rounded-2xl shadow-lg" />
    </div>
  </section>
</Layout>
